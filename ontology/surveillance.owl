<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/ontologies/surveillance#"
     xml:base="http://www.semanticweb.org/ontologies/surveillance"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:surv="http://www.semanticweb.org/ontologies/surveillance#">
    
    <owl:Ontology rdf:about="http://www.semanticweb.org/ontologies/surveillance">
        <rdfs:label>Surveillance Domain Ontology</rdfs:label>
        <rdfs:comment>Domain ontology modeling surveillance concepts, actors, vehicles, luggage, and security entities for semantic query expansion.</rdfs:comment>
    </owl:Ontology>

    <!-- Base Class: SurveillanceEntity -->
    <owl:Class rdf:about="#SurveillanceEntity">
        <rdfs:label>SurveillanceEntity</rdfs:label>
        <rdfs:label>entity</rdfs:label>
        <rdfs:label>object</rdfs:label>
    </owl:Class>

    <!-- Person Hierarchy -->
    <owl:Class rdf:about="#Person">
        <rdfs:subClassOf rdf:resource="#SurveillanceEntity"/>
        <rdfs:label>Person</rdfs:label>
        <rdfs:label>person</rdfs:label>
        <rdfs:label>people</rdfs:label>
        <rdfs:label>human</rdfs:label>
        <rdfs:label>pedestrian</rdfs:label>
        <rdfs:label>individual</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#SuspiciousPerson">
        <rdfs:subClassOf rdf:resource="#Person"/>
        <rdfs:label>SuspiciousPerson</rdfs:label>
        <rdfs:label>intruder</rdfs:label>
        <rdfs:label>trespasser</rdfs:label>
        <rdfs:label>loiterer</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#StaffMember">
        <rdfs:subClassOf rdf:resource="#Person"/>
        <rdfs:label>StaffMember</rdfs:label>
        <rdfs:label>staff</rdfs:label>
        <rdfs:label>employee</rdfs:label>
        <rdfs:label>guard</rdfs:label>
        <rdfs:label>security</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Student">
        <rdfs:subClassOf rdf:resource="#Person"/>
        <rdfs:label>Student</rdfs:label>
        <rdfs:label>student</rdfs:label>
        <rdfs:label>pupil</rdfs:label>
    </owl:Class>

    <!-- Vehicle Hierarchy -->
    <owl:Class rdf:about="#Vehicle">
        <rdfs:subClassOf rdf:resource="#SurveillanceEntity"/>
        <rdfs:label>Vehicle</rdfs:label>
        <rdfs:label>vehicle</rdfs:label>
        <rdfs:label>transport</rdfs:label>
        <rdfs:label>automotive</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Car">
        <rdfs:subClassOf rdf:resource="#Vehicle"/>
        <rdfs:label>Car</rdfs:label>
        <rdfs:label>car</rdfs:label>
        <rdfs:label>automobile</rdfs:label>
        <rdfs:label>sedan</rdfs:label>
        <rdfs:label>suv</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Bus">
        <rdfs:subClassOf rdf:resource="#Vehicle"/>
        <rdfs:label>Bus</rdfs:label>
        <rdfs:label>bus</rdfs:label>
        <rdfs:label>coach</rdfs:label>
        <rdfs:label>shuttle</rdfs:label>
        <rdfs:label>transit</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Motorcycle">
        <rdfs:subClassOf rdf:resource="#Vehicle"/>
        <rdfs:label>Motorcycle</rdfs:label>
        <rdfs:label>motorcycle</rdfs:label>
        <rdfs:label>bike</rdfs:label>
        <rdfs:label>motorbike</rdfs:label>
        <rdfs:label>scooter</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Bicycle">
        <rdfs:subClassOf rdf:resource="#Vehicle"/>
        <rdfs:label>Bicycle</rdfs:label>
        <rdfs:label>bicycle</rdfs:label>
        <rdfs:label>cycle</rdfs:label>
        <rdfs:label>bike</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Truck">
        <rdfs:subClassOf rdf:resource="#Vehicle"/>
        <rdfs:label>Truck</rdfs:label>
        <rdfs:label>truck</rdfs:label>
        <rdfs:label>lorry</rdfs:label>
        <rdfs:label>van</rdfs:label>
        <rdfs:label>pickup</rdfs:label>
    </owl:Class>

    <!-- Luggage & Carry Items Hierarchy -->
    <owl:Class rdf:about="#Luggage">
        <rdfs:subClassOf rdf:resource="#SurveillanceEntity"/>
        <rdfs:label>Luggage</rdfs:label>
        <rdfs:label>luggage</rdfs:label>
        <rdfs:label>baggage</rdfs:label>
        <rdfs:label>bag</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Backpack">
        <rdfs:subClassOf rdf:resource="#Luggage"/>
        <rdfs:label>Backpack</rdfs:label>
        <rdfs:label>backpack</rdfs:label>
        <rdfs:label>rucksack</rdfs:label>
        <rdfs:label>knapsack</rdfs:label>
        <rdfs:label>schoolbag</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Handbag">
        <rdfs:subClassOf rdf:resource="#Luggage"/>
        <rdfs:label>Handbag</rdfs:label>
        <rdfs:label>handbag</rdfs:label>
        <rdfs:label>purse</rdfs:label>
        <rdfs:label>tote</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Suitcase">
        <rdfs:subClassOf rdf:resource="#Luggage"/>
        <rdfs:label>Suitcase</rdfs:label>
        <rdfs:label>suitcase</rdfs:label>
        <rdfs:label>briefcase</rdfs:label>
        <rdfs:label>trolley</rdfs:label>
    </owl:Class>

    <!-- Electronic Devices Hierarchy -->
    <owl:Class rdf:about="#ElectronicDevice">
        <rdfs:subClassOf rdf:resource="#SurveillanceEntity"/>
        <rdfs:label>ElectronicDevice</rdfs:label>
        <rdfs:label>electronics</rdfs:label>
        <rdfs:label>device</rdfs:label>
        <rdfs:label>gadget</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Laptop">
        <rdfs:subClassOf rdf:resource="#ElectronicDevice"/>
        <rdfs:label>Laptop</rdfs:label>
        <rdfs:label>laptop</rdfs:label>
        <rdfs:label>notebook</rdfs:label>
        <rdfs:label>computer</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#CellPhone">
        <rdfs:subClassOf rdf:resource="#ElectronicDevice"/>
        <rdfs:label>CellPhone</rdfs:label>
        <rdfs:label>cell phone</rdfs:label>
        <rdfs:label>phone</rdfs:label>
        <rdfs:label>mobile</rdfs:label>
        <rdfs:label>smartphone</rdfs:label>
    </owl:Class>

    <!-- Locations & Surveillance Zones -->
    <owl:Class rdf:about="#SurveillanceZone">
        <rdfs:label>SurveillanceZone</rdfs:label>
        <rdfs:label>zone</rdfs:label>
        <rdfs:label>area</rdfs:label>
        <rdfs:label>location</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#EntranceGate">
        <rdfs:subClassOf rdf:resource="#SurveillanceZone"/>
        <rdfs:label>EntranceGate</rdfs:label>
        <rdfs:label>entrance</rdfs:label>
        <rdfs:label>gate</rdfs:label>
        <rdfs:label>doorway</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#ParkingArea">
        <rdfs:subClassOf rdf:resource="#SurveillanceZone"/>
        <rdfs:label>ParkingArea</rdfs:label>
        <rdfs:label>parking</rdfs:label>
        <rdfs:label>garage</rdfs:label>
        <rdfs:label>driveway</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Corridor">
        <rdfs:subClassOf rdf:resource="#SurveillanceZone"/>
        <rdfs:label>Corridor</rdfs:label>
        <rdfs:label>corridor</rdfs:label>
        <rdfs:label>hallway</rdfs:label>
        <rdfs:label>passage</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#RestrictedZone">
        <rdfs:subClassOf rdf:resource="#SurveillanceZone"/>
        <rdfs:label>RestrictedZone</rdfs:label>
        <rdfs:label>restricted area</rdfs:label>
        <rdfs:label>secure zone</rdfs:label>
        <rdfs:label>no entry</rdfs:label>
    </owl:Class>

    <!-- Object Properties -->
    <owl:ObjectProperty rdf:about="#carriedBy">
        <rdfs:domain rdf:resource="#Luggage"/>
        <rdfs:range rdf:resource="#Person"/>
        <rdfs:label>carried by</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#locatedIn">
        <rdfs:domain rdf:resource="#SurveillanceEntity"/>
        <rdfs:range rdf:resource="#SurveillanceZone"/>
        <rdfs:label>located in</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#nearTo">
        <rdfs:domain rdf:resource="#SurveillanceEntity"/>
        <rdfs:range rdf:resource="#SurveillanceEntity"/>
        <rdfs:label>near to</rdfs:label>
    </owl:ObjectProperty>

    <!-- Personal Attribute & Accessory Hierarchy -->
    <owl:Class rdf:about="#Accessory">
        <rdfs:subClassOf rdf:resource="#SurveillanceEntity"/>
        <rdfs:label>Accessory</rdfs:label>
        <rdfs:label>accessory</rdfs:label>
        <rdfs:label>attribute</rdfs:label>
        <rdfs:label>item</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Eyewear">
        <rdfs:subClassOf rdf:resource="#Accessory"/>
        <rdfs:label>Eyewear</rdfs:label>
        <rdfs:label>glasses</rdfs:label>
        <rdfs:label>eyeglasses</rdfs:label>
        <rdfs:label>sunglasses</rdfs:label>
        <rdfs:label>spectacles</rdfs:label>
        <rdfs:label>eyewear</rdfs:label>
        <rdfs:label>shades</rdfs:label>
        <rdfs:label>frames</rdfs:label>
        <rdfs:label>specs</rdfs:label>
    </owl:Class>

    <owl:ObjectProperty rdf:about="#wornBy">
        <rdfs:domain rdf:resource="#Accessory"/>
        <rdfs:range rdf:resource="#Person"/>
        <rdfs:label>worn by</rdfs:label>
        <rdfs:label>wearing</rdfs:label>
    </owl:ObjectProperty>

</rdf:RDF>
